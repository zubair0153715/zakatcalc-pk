<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/app_name"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/green_700" />

            <Button
                android:id="@+id/btnLangEn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lang_en" />

            <Button
                android:id="@+id/btnLangUr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lang_ur" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:padding="12dp"
            android:background="@drawable/card_bg">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/title_rates"
                android:textStyle="bold"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvGoldRate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/gold"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvSilverRate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/silver"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvNisabGold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvNisabSilver"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvRatesUpdated"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp">

                <Button
                    android:id="@+id/btnRefresh"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/btn_refresh" />

                <Button
                    android:id="@+id/btnEditRates"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/btn_edit_rates" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:padding="12dp"
            android:background="@drawable/card_bg">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/title_assets"
                android:textStyle="bold"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/etCash"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:hint="@string/hint_cash"
                android:inputType="numberDecimal" />

            <EditText
                android:id="@+id/etGold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_gold_grams"
                android:inputType="numberDecimal" />

            <EditText
                android:id="@+id/etSilver"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_silver_grams"
                android:inputType="numberDecimal" />

            <EditText
                android:id="@+id/etBusiness"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_business"
                android:inputType="numberDecimal" />

            <EditText
                android:id="@+id/etLiabilities"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_liabilities"
                android:inputType="numberDecimal" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:padding="12dp"
            android:background="@drawable/card_bg">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/title_agri"
                android:textStyle="bold"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/etHarvest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:hint="@string/hint_harvest"
                android:inputType="numberDecimal" />

            <RadioGroup
                android:id="@+id/rgIrrigation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rbNatural"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/irrigation_natural" />

                <RadioButton
                    android:id="@+id/rbArtificial"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/irrigation_artificial" />
            </RadioGroup>
        </LinearLayout>

        <Button
            android:id="@+id/btnCalculate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/btn_calculate"
            android:textSize="17sp" />

        <LinearLayout
            android:id="@+id/cardResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="gone"
            android:background="@drawable/card_bg">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/title_result"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="@color/green_700" />

            <TextView
                android:id="@+id/tvWealth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvNisab"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvZakat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/green_700"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/tvUshr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvBelow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="14sp"
                android:visibility="gone"
                android:text="@string/result_below" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/result_note"
                android:textSize="12sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="24dp" />
    </LinearLayout>
</ScrollView>
